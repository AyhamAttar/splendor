# Backend environment. Copy to `.env` for local development (`.env` is gitignored).

# PostgreSQL connection string used by Prisma and the app at runtime.
# Matches the credentials in the repo-root docker-compose.yml.
DATABASE_URL="postgresql://splendor:splendor@localhost:5432/splendor?schema=public"

# HTTP port the NestJS API listens on.
PORT=4000

# Comma-separated list of allowed browser origins for CORS (frontend dev server).
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# How long (hours) a game may sit idle before the sweeper deletes it.
GAME_TTL_HOURS=24

# --- Lobby & matchmaking (Phase 3) --------------------------------------------

# How long (hours) a room may sit idle before the room sweeper deletes it.
ROOM_TTL_HOURS=6

# Quick-match: group size that matches instantly. Below this, a game still
# starts after MATCH_WAIT_MS once at least 2 players are waiting.
MATCH_TARGET=4

# Quick-match: how long (ms) the oldest waiting player waits before a smaller
# (2–3 player) game is formed.
MATCH_WAIT_MS=12000

# --- Auth (Phase 1) -----------------------------------------------------------

# Secret for signing access-token JWTs. REQUIRED in production (the app refuses
# to use an insecure fallback when NODE_ENV=production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-access-secret"

# Access-token lifetime (any ms/vercel-ms string, e.g. 15m, 1h). Keep it short;
# the refresh token silently renews it.
JWT_ACCESS_TTL="15m"

# Secret for signing durable guest tokens. REQUIRED in production. Generate as
# above with a fresh value (do not reuse JWT_ACCESS_SECRET).
GUEST_TOKEN_SECRET="change-me-guest-secret"

# How long (days) a refresh token / session stays valid before re-login.
AUTH_REFRESH_TTL_DAYS=30

# Refresh-cookie flags. In production set COOKIE_SECURE=true (HTTPS). Use
# SameSite=lax when the frontend and API share a site (default), or "none"
# (with COOKIE_SECURE=true) for truly cross-site deployments.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Google OAuth is designed-for but not built in Phase 1; leave disabled.
OAUTH_GOOGLE_ENABLED=false

# --- Production hardening (Phase 5) -------------------------------------------

# pino log level: trace | debug | info | warn | error | fatal. Logs are JSON;
# each request carries an x-request-id correlation id.
LOG_LEVEL=info

# Per-socket flood protection (token bucket). BURST is the bucket capacity (a
# short burst of messages allowed); REFILL_PER_SEC is the sustained rate.
WS_RATE_BURST=30
WS_RATE_REFILL_PER_SEC=15

# When set, GET /metrics requires `Authorization: Bearer <token>`. Leave unset
# for local dev; set it (and firewall the port) in production.
# METRICS_TOKEN=

# Sentry error tracking. Entirely optional: with no DSN the app reports nothing.
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
