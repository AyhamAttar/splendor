# Normalize line endings: store text as LF in the repo (native on checkout).
# Keeps the tree consistent across Windows dev and Linux CI/containers.
* text=auto eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
